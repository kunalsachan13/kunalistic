# =================================================================
# KUNALISTIC PRODUCTION ENVIRONMENT CONFIGURATION
# Primary Domain: https://kunalistic.io
# =================================================================

# 1. Application
NEXT_PUBLIC_APP_URL=https://kunalistic.io

# 2. Supabase Configuration (PostgreSQL, Auth, RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your_publishable_key
SUPABASE_SECRET_KEY=sbs_your_secret_service_key

# 3. AI Provider Configuration (Provider-agnostic)
# Options: heuristics (built-in fallback, default), openai, gemini, anthropic
AI_PROVIDER=heuristics
AI_MODEL=gpt-4o-mini
AI_API_KEY=

# 4. Voluntary Support & Payment Provider
# Options: simulator (development & test ready, default), razorpay, stripe
PAYMENT_PROVIDER=simulator
PAYMENT_PUBLIC_KEY=rzp_live_your_public_key
PAYMENT_SECRET_KEY=your_secret_key
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret

# 5. Privacy-Conscious Analytics
ANALYTICS_ENABLED=true
